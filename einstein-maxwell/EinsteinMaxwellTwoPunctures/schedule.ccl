# Schedule definitions for thorn EinsteinMaxwellTwoPunctures

if (CCTK_Equals(initial_data, "EinsteinMaxwelltwopunctures"))
{
  STORAGE: energy, angular_momentum, puncture_adm_mass, bare_mass

  if (keep_u_around) {
    STORAGE: puncture_u
  }

  SCHEDULE EinsteinMaxwellTwoPunctures_ParamCheck AT PARAMCHECK
  {
    LANG: C
  } "Check Einstein-Maxwell TwoPunctures parameters and thorn requirements"

  if (schedule_in_ADMBase_InitialData)
  {
      SCHEDULE GROUP EinsteinMaxwellTwoPunctures_Group IN ADMBase_InitialData
      {
      } "Einstein-Maxwell TwoPunctures initial data group"
  }
  else
  {
      SCHEDULE GROUP EinsteinMaxwellTwoPunctures_Group AT Initial AFTER ADMBase_InitialData BEFORE ADMBase_PostInitial AFTER HydroBase_Initial BEFORE SetTmunu BEFORE HydroBase_Prim2ConInitial
      {
      } "Einstein-Maxwell TwoPunctures initial data group"
  }

  SCHEDULE EinsteinMaxwellTwoPunctures IN EinsteinMaxwellTwoPunctures_Group
  {
    LANG: C
    STORAGE: puncture_u
    READS: Grid::coordinates(Everywhere)
    WRITES: EinsteinMaxwellTwoPunctures::mp(Everywhere), EinsteinMaxwellTwoPunctures::mm(Everywhere),
            EinsteinMaxwellTwoPunctures::mp_adm(Everywhere), EinsteinMaxwellTwoPunctures::mm_adm(Everywhere),
            EinsteinMaxwellTwoPunctures::E(Everywhere), EinsteinMaxwellTwoPunctures::J1(Everywhere),
            EinsteinMaxwellTwoPunctures::J2(Everywhere), EinsteinMaxwellTwoPunctures::J3(Everywhere),
            EinsteinMaxwellTwoPunctures::puncture_u(Everywhere)
    WRITES: StaticConformal::conformal_state(Everywhere),
            StaticConformal::confac_2derivs(Everywhere),
            StaticConformal::confac_1derivs(Everywhere),
            StaticConformal::confac(Everywhere)
    WRITES: ADMBase::alp(Everywhere), ADMBase::metric(Everywhere), ADMBase::curv(Everywhere)
    WRITES: ProcaBase::Ei(Everywhere), EinsteinMaxwellEvolve::Bi(Everywhere), EinsteinMaxwellEvolve::EM_Psi(Everywhere), EinsteinMaxwellEvolve::EM_Phi(Everywhere)
    SYNC: ADMBase::metric ADMBase::curv ADMBase::lapse
    SYNC: ProcaBase::Ei, EinsteinMaxwellEvolve::Bi, EinsteinMaxwellEvolve::EM_Psi, EinsteinMaxwellEvolve::EM_Phi
  } "Create electric/magnetic charged puncture black hole initial data"

  SCHEDULE EinsteinMaxwellTwoPunctures_Metadata IN EinsteinMaxwellTwoPunctures_Group AFTER EinsteinMaxwellTwoPunctures
  {
    LANG: C
    OPTIONS: global
  } "Output Einstein-Maxwell TwoPunctures metadata"
}
